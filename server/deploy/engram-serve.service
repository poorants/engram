[Unit]
Description=engram remote MCP server (engram serve)
After=network-online.target docker.service
Wants=network-online.target

[Service]
# Settings live beside the binary, 600 root — the list is in
# `engram serve --help`: ENGRAM_TOKEN (the store's own credential, the same
# value as server/.env), ENGRAM_SERVE_ISSUER, ENGRAM_SERVE_KEY, the Google
# client id and secret, ENGRAM_SERVE_ALLOW, optionally ENGRAM_SERVE_AUTHOR.
# The proxy in front must hand this server a whole origin: the OAuth metadata
# is at /.well-known/.
EnvironmentFile=/opt/engram-serve/serve.env
ExecStart=/opt/engram-serve/bin/engram serve --addr 127.0.0.1:8682 --store http://127.0.0.1:8081
DynamicUser=yes
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
