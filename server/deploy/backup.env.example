# /etc/engram/backup.env — read by engram-backup.service (through the drop-in
# engram-backup.service.d/upload.conf) and engram-restore-rehearsal.service.
#
#   sudo install -d -m 0700 /etc/engram
#   sudo install -m 0600 deploy/backup.env.example /etc/engram/backup.env   # then edit
#
# Holds no secret itself: the remote's credentials live in the rclone config.
# It is root-only anyway, because it says where the backups are.

# Where the dumps go: any rclone remote, `<remote>:<bucket>[/prefix]`. Required.
ENGRAM_BACKUP_REMOTE=

# Retention, in generations (one per day): the newest N, plus the newest of
# each of the last M calendar months that have one (the current month counts).
ENGRAM_BACKUP_KEEP_DAILY=14
ENGRAM_BACKUP_KEEP_MONTHLY=0

# A pruned generation is hidden, not destroyed (B2 with hard_delete = false).
# true: purge hidden versions at once — needs a key with deleteFiles.
# false: leave them to the bucket rule daysFromHidingToDeleting — the setting
#        for a key that cannot delete.
ENGRAM_BACKUP_PURGE_HIDDEN=true

# The rclone config that holds the remote's key. Unset, rclone's default
# (/root/.config/rclone/rclone.conf for root).
#RCLONE_CONFIG=/root/.config/rclone/rclone.conf

# Restore rehearsal knobs (defaults shown).
#ENGRAM_REHEARSAL_IMAGE=postgres:17
#ENGRAM_REHEARSAL_MEMORY=512m
#ENGRAM_REHEARSAL_SCRATCH=/var/tmp
