# cp .env.example .env and fill it in. .env is never committed.

# Generate both: openssl rand -hex 24
POSTGRES_PASSWORD=

# The store's one credential. It answers a single question -- may this caller
# use this store at all -- and it is NOT a permission system: whoever holds it
# can read everything and write everything. What a client may do is decided by
# whether that machine was given the token, not by which token it holds.
# The store refuses to start without one.
ENGRAM_TOKEN=

# The groups this store admits. If the first segment of a document path is not
# listed here, the write is refused with 403 — which is what keeps knowledge
# from repos that should not be here out of it. It is a list of GROUPS, not
# repos: a new repo under an admitted group works with no change, and a personal
# repo never does. **Empty means nothing can be written.**
ENGRAM_OWNERS=

# Serve reads to callers who present no token. Off by default: a store that
# anyone who can reach the port may read is fine on a LAN and is not fine the
# first time it lands on a public IP, and which of the two this is is not
# something the software can check. Turn it on deliberately, for the deployment
# where everyone who can reach the port is already allowed to read everything.
#
# Writing always needs the token, whatever this says.
#ENGRAM_PUBLIC_READS=true

# Where the database files live. Empty uses ./data next to this file.
ENGRAM_DATA=
ENGRAM_PORT=8081

# The timezone revision timestamps are displayed in (e.g. Asia/Seoul, Europe/Berlin).
ENGRAM_TZ=UTC

# --- Resources -------------------------------------------------------------
# The defaults are sized for the machine this usually lands on: a small VPS
# that already runs something else. Postgres's own defaults assume the box is
# its own, and unbounded it can take the neighbour down instead of itself.
#
# On a host with room, raise these — ENGRAM_DB_MEMORY=2g and
# shared_buffers=512MB is a reasonable next step. Leave them empty for the
# defaults shown.
#ENGRAM_DB_MEMORY=512m
#ENGRAM_APP_MEMORY=384m
#ENGRAM_DB_SHARED_BUFFERS=128MB
#ENGRAM_DB_MAX_CONNECTIONS=50
#ENGRAM_DB_WORK_MEM=4MB
#ENGRAM_DB_MAINTENANCE_WORK_MEM=64MB
#ENGRAM_DB_EFFECTIVE_CACHE_SIZE=384MB
